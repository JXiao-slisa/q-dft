# ── slisaDFT community edition 配置模板 ────────────────────────
# 复制为 .env 并填入真实值：  cp .env.example .env

# ── LLM（OpenAI 兼容端点，必填）────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-key-here

# ── 引擎模式 ────────────────────────────────────────────────────
# real = 调用真实引擎；mock = 确定性合成数据（演示/测试，Rule Zero 标记）
SLISADFT_ENGINE_MODE=real

# ── DFT 引擎路径（real 模式按需配置）────────────────────────────
VASP_EXE=
VASP_GAM=
VASPKIT_EXE=
VASP_POTCAR_DIR=
CP2K_EXE=
ABACUS_EXE=

# ── MLIP 模型路径 ───────────────────────────────────────────────
# MACE_MODEL=/path/to/mace.model
DPA4_MODEL=
MLIP_MODEL_DIR=models/mlip

# ── SLURM / MPI（集群）─────────────────────────────────────────
SLURM_PARTITION=CPU
SLURM_NTASKS=16
SLURM_MEM_MB=6000
SLURM_TIME=24:00:00
MPI_RUN=mpirun
MPI_ENV_SCRIPT=
MPI_EXTRA_PATH=

# ── 行为 ────────────────────────────────────────────────────────
REPORT_LANGUAGE=zh
